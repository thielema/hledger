# unify financial credit union savings

#source AccountHistory*.csv
#include _unify.rules

# Assumes simplefin.json has been downloaded by, eg: hledger import -g -> getdata -> simplefinjson
source | simplefincsv ../data/simplefin.json 'unify.*savings'

include _simplefin.rules

account1 assets:bank:unify:savings
include _common.rules

if (To|From) Share 0002
 account2 assets:bank:unify:checking
