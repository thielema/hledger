#!/usr/bin/env bash
# getdata is a helper for hledger's `get` command (data phase). You can also run it yourself.
# It is intended to download statements (CSV, OFX, etc.) from banks, brokerages,
# and other financial providers into the current directory, ready for hledger to
# read via CSV rules or convert with the `import` command.
#
# It is run by `hledger get` with the journal's `data/` directory as the
# current working directory, so any files it creates land there.
#
# This shipped version is a stub. Copy it into your journal's `data/` directory
# and customise it for your accounts and tools.
#
# See also:
# https://hledger.org/import-csv.html
# https://hledger.org/csv.html

set -euo pipefail

cat >&2 <<'EOF'
getdata: this is the sample stub script.
It does not fetch anything yet. Customise this script to download CSV or other data files
from your bank, brokerage, or other financial providers, into the working directory,
for later processing by your rules files.
EOF

# Whether you can automate data fetching depends on your institutions and appetite for scripting.
# Here are two easy ways to automate data fetching, using other scripts from the hledger repo's bin directory:
#
# simplefinjson >simplefin.json   # fetch recent transactions from SimpleFIN (see also simplefinsetup)
# paypaljson    >paypal.json      # fetch recent transactions from PayPal
#
# For an example of rules files converting these, see
# https://github.com/hledgerorg/hledger/blob/main/examples/csv/banking/unify-checking.rules
# https://github.com/hledgerorg/hledger/blob/main/examples/csv/other/paypal-simplefin.rules
